{
  "servers": [
    {
      "name": "PM-Tool MVC",
      "directory": "/home/joruf/Dokumente/pmtool",
      "command": "/usr/bin/php8.2 -S localhost:{port} -t public/ public/router.php",
      "port": 8001,
      "env": {
        "XDEBUG_SESSION": "1",
        "PHP_CLI_SERVER_WORKERS": "6"
      },
      "autostart": true
    },
    {
      "name": "ServiceReports MVC",
      "directory": "/home/joruf/Dokumente/servicereports",
      "command": "/usr/bin/php8.2 -S localhost:{port} -t public/",
      "port": 8002,
      "env": {
        "XDEBUG_SESSION": "1",
        "PHP_CLI_SERVER_WORKERS": "6"
      },
      "autostart": true
    },
    {
      "name": "PM-Tool Legacy",
      "directory": "/home/joruf/Dokumente/pmtool-legacy",
      "command": "/usr/bin/php8.2 -S localhost:{port} -t html/",
      "port": 8003,
      "env": {
        "XDEBUG_SESSION": "1",
        "PHP_CLI_SERVER_WORKERS": "6"
      },
      "autostart": true
    },
    {
      "name": "ServiceReports Legacy",
      "directory": "/home/joruf/Dokumente/servicereports-legacy",
      "command": "/usr/bin/php8.2 -S localhost:{port} -t html/",
      "port": 8004,
      "env": {
        "XDEBUG_SESSION": "1"
      },
      "autostart": false
    },
    {
      "name": "Pebot",
      "directory": "/home/joruf/Dokumente/pebot/joomla",
      "command": "/usr/bin/php8.4 -d max_input_vars=5000 -d max_input_time=120 -d xdebug.mode=off -S localhost:{port} -t .",
      "port": 8005,
      "env": {
        "PHP_CLI_SERVER_WORKERS": "2"
      },
      "autostart": true
    },
    {
      "name": "Mailpit",
      "directory": "/home/joruf/.local/share/mailpit",
      "command": "/home/joruf/.local/share/devserver-commander/bin/mailpit --listen 0.0.0.0:{port} --smtp 0.0.0.0:1025 --database /home/joruf/.local/share/mailpit/mailpit.db --smtp-auth-accept-any --smtp-auth-allow-insecure",
      "port": 8025,
      "env": {},
      "autostart": true
    },
    {
      "name": "XD-Joomla-Import",
      "directory": "/home/joruf/Dokumente/xd-image-extractor",
      "command": "node server.js",
      "port": 4321,
      "env": {},
      "autostart": false
    }
  ],
  "services": [
    {
      "name": "MariaDB",
      "unit": "mariadb.service",
      "port": 3306,
      "data_directory": "/var/lib/mysql"
    }
  ]
}