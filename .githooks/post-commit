#!/bin/sh
#
# Refreshes the VERSION file after every commit.
#
# The version number itself is derived from the history and needs nobody to
# raise it (see version.py), but the file that carries it to an installation
# without .git does need writing. DevServer Commander also rewrites it the first
# time it starts after a commit; this closes the gap for anything that reads the
# file before that, a copy to another machine or build-exe.py for instance.
#
# Activate once per checkout:  git config core.hooksPath .githooks
#
# Never fails a commit: everything here is best effort, and a missing Python
# simply leaves the file as it was.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

command -v python3 >/dev/null 2>&1 || exit 0

python3 "$root/version.py" --write >/dev/null 2>&1 || exit 0

exit 0
